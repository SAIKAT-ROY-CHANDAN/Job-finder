# JobPilot Environment Variables

# --- Database (PostgreSQL) ---
# e.g. postgresql://user:password@localhost:5432/jobpilot
DATABASE_URL=

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional override
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Authentication ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Application settings ---
MAX_JOB_SCORING_LIMIT=100
MAX_APPLICATIONS_PER_USER=20

# --- Browser automation ---
# Set to true to enable the Playwright automation server
PLAYWRIGHT_ENABLED=true

# --- Job discovery ---
# JSearch (RapidAPI) key for Google-job results. Optional; Google source is
# skipped when absent. Get a free key at https://rapidapi.com/taggdata/api/jsearch
# RAPIDAPI_KEY=

# Optional comma-separated job RSS feed URLs. These are ADDED to the built-in
# defaults (WeWorkRemotely all + programming/design/devops category feeds),
# not a replacement.
# Example: JOB_RSS_FEED_URLS=https://jobicy.com/jobs/feed

# Optional LinkedIn guest-scraping source. Best-effort only: LinkedIn blocks
# guest scraping aggressively (403/429), it has no official jobs API, and this
# relies on an undocumented guest endpoint. Set to 1 to enable, leave unset to
# skip. Set LINKEDIN_FETCH_DETAILS to false to skip per-posting description
# fetches (faster, value metadata only).
# LINKEDIN_ENABLED=1
# LINKEDIN_FETCH_DETAILS=true
